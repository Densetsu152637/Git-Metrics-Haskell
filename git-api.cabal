cabal-version:       2.2

name:                git-api
version:             0.1.0.0
homepage:            https://github.com/Densetsu152637/Git-Metrics-Haskell#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Nicholas Bisset
maintainer:          nicholas.bisset.1000@gmail.com
copyright:           2025 Nicholas Bisset
category:            Web
synopsis:            HTTP and WebSocket API for repository metrics
description:         Clones Git repositories and exposes commit, branch, contributor, and file-change metrics.
build-type:          Simple
extra-doc-files:     README.md
                     CHANGELOG.md

source-repository head
  type:               git
  location:           https://github.com/Densetsu152637/Git-Metrics-Haskell.git

executable git-api
  main-is:             Main.hs
  hs-source-dirs:      src
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  default-language:    Haskell2010
  other-modules:
      Api
      Process
      Parsing
      GitCommands
      Command
      Types
      Threading
  build-depends:
      base >= 4.7 && < 5,
      wai,
      warp,
      websockets >= 0.13.0.0,
      wai-websockets,
      aeson,
      text,
      bytestring,
      async,
      http-types,
      containers,
      time,
      stm,
      process,
      directory,
      filepath,
      deepseq,
      network,
      regex-posix
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields
      -Wredundant-constraints

test-suite threading-tests
  type:                 exitcode-stdio-1.0
  main-is:              ThreadingSpec.hs
  hs-source-dirs:       test
                        src
  other-modules:        Threading
  default-language:     Haskell2010
  ghc-options:          -threaded -rtsopts -with-rtsopts=-N -Wall
  build-depends:
      base >= 4.7 && < 5,
      containers,
      deepseq,
      stm
