cabal-version:       2.2

name:                git-api
version:             0.1.0.0
homepage:            https://github.com/Densetsu152637/Git-Metrics-Haskell#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Nicholas Bisset
maintainer:          nicholas.bisset.1000@gmail.com
copyright:           2025 Nicholas Bisset
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable git-api
  main-is:             Main.hs
  hs-source-dirs:      src
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  default-language:    Haskell2010
  other-modules:
      Api
      Process
      Parsing
      GitCommands
      Command
      Types
      Threading
  build-depends:
      base >= 4.7 && < 5,
      wai,
      warp,
      websockets >= 0.13.0.0,
      wai-websockets,
      aeson,
      text,
      bytestring,
      async,
      http-types,
      containers,
      time,
      stm,
      process,
      directory,
      filepath,
      deepseq,
      network,
      regex-posix
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields
      -Wredundant-constraints
