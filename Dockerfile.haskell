# syntax=docker/dockerfile:1

# -------- Build Stage --------
# LTS 23.25 uses GHC 9.8.4. Matching it here prevents Stack from downloading
# and retaining a second GHC installation during every cold build.
FROM haskell:9.8.4-slim-bullseye AS builder

WORKDIR /build

# Copy Stack configuration & Cabal files first for caching
COPY stack.yaml stack.yaml.lock ./
COPY *.cabal ./

# Keep dependencies in a normal image layer so Buildx can export and restore
# them through the GitHub Actions cache. The system compiler is deliberately
# required so Stack cannot install another GHC.
RUN stack --system-ghc --no-install-ghc build --only-dependencies

# Copy the rest of the source code
COPY . .

# Build the binary and put only the executable into the next stage.
RUN stack --system-ghc --no-install-ghc build \
      --copy-bins --local-bin-path /out

# -------- Runtime Stage --------
FROM debian:bookworm-slim

# Install runtime libraries only. Development headers belong in the builder.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git libgmp10 && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m appuser
USER appuser

# Copy binary from builder
COPY --from=builder /out/git-api /usr/local/bin/git-api

WORKDIR /projects/git-api
EXPOSE 8081

CMD ["git-api"]
